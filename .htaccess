# Used only if the subdomain's document root points at the repo root instead of /public.
Options -Indexes
RewriteEngine On
RewriteRule ^(lib|storage)(/|$) - [F,L]
RewriteRule ^(config\.php|config\.sample\.php|install\.sql|README\.md|\.git.*)$ - [F,L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
